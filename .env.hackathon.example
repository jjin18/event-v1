# ── Hackathon Judging Platform ── copy to .env and fill in ──────────────────

# Admin login password (organizer workspace at /admin)
ADMIN_PASSWORD=change-me-before-deploy

# Secret used to sign judge JWT tokens
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-64-char-hex-secret

# Full public URL of your deployment (used in QR code URLs)
# Set this AFTER Railway assigns your domain
APP_URL=https://your-app.up.railway.app

# Path to the Railway Volume mount point — do not change this
DATA_DIR=/app/data

# Port (Railway sets this automatically — do not set manually)
# PORT=8000
