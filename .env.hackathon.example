# ── Hackathon Judging Platform ── copy to .env and fill in ──────────────────

# Admin login password (organizer workspace at /admin)
ADMIN_PASSWORD=change-me-before-deploy

# Secret used to sign judge JWT tokens — generate with: openssl rand -hex 32
JWT_SECRET=replace-with-64-char-hex-secret

# Full public URL of your deployment (used in QR code URLs)
APP_URL=https://your-hackathon-app.railway.app

# Port (Railway sets this automatically)
PORT=8000
