# ── Stage 1: Build React frontend ───────────────────────────────────────────
FROM node:22-slim AS frontend-builder

WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci --silent
COPY frontend/ .
RUN npm run build

# ── Stage 2: Python runtime ──────────────────────────────────────────────────
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements.txt backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt

COPY backend/ backend/
COPY --from=frontend-builder /app/frontend/dist frontend/dist

# /app/data is where the Railway Volume is mounted.
# DB, backups, and uploads all live here so they survive redeploys.
RUN mkdir -p /app/data/backups /app/uploads

ENV PORT=8000
ENV DATA_DIR=/app/data

EXPOSE 8000

# Seed on very first boot (empty volume), then start server.
CMD ["sh", "-c", "[ ! -f /app/data/hackathon.db ] && python backend/seed.py; python -m uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1"]
